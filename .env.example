# 同花顺交易配置
# 复制此文件为 .env 并填入配置
# .env 文件不应提交到 git
#
# 注意：实盘接口已移除，本程序只生成人工调仓清单，不接入真实券商。
# 以下字段保留仅作占位，不再用于真实下单。

# 同花顺客户端下单程序路径 (已不再用于真实下单，保留占位)
THS_EXE_PATH=C:\同花顺\xiadan.exe

# 同花顺账号 (已不再使用)
THS_ACCOUNT=your_account
THS_PASSWORD=your_password

# 策略名称: momentum / mean_reversion
STRATEGY_NAME=momentum

# 策略参数 (JSON格式)
STRATEGY_PARAMS={"lookback": 60, "threshold": 0.0}

# 股票池 (逗号分隔)
STOCK_POOL=000001,000002,600000,600519,000858

# 初始资金 (影响仓位计算)
INITIAL_CAPITAL=1000000

# 最大持仓数量
MAX_POSITIONS=5

# 调仓频率: daily / weekly / monthly
REBALANCE_FREQ=daily
